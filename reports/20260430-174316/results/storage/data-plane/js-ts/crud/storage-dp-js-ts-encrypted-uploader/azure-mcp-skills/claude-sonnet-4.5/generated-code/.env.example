# Azure Storage Account Configuration
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name

# Azure Key Vault Configuration
AZURE_KEY_VAULT_URL=https://your-keyvault-name.vault.azure.net/
AZURE_KEY_VAULT_KEY_NAME=your-key-name

# Azure Authentication (Managed Identity)
# When running locally, ensure you're logged in with Azure CLI:
#   az login
# When running in Azure (e.g., App Service, VM), managed identity is used automatically
