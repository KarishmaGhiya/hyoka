# Azure Storage Account URL
# Format: https://<storage-account-name>.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_URL=https://mystorageaccount.blob.core.windows.net

# Azure Key Vault URL
# Format: https://<keyvault-name>.vault.azure.net
AZURE_KEYVAULT_URL=https://mykeyvault.vault.azure.net

# Key Vault Key Name
# The name of the RSA key in Key Vault used for wrapping/unwrapping data encryption keys
AZURE_KEYVAULT_KEY_NAME=my-encryption-key

# Authentication:
# This project uses DefaultAzureCredential which automatically tries multiple authentication methods:
# 1. Environment variables (AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_CLIENT_SECRET)
# 2. Managed Identity (when running in Azure)
# 3. Azure CLI (when running locally with 'az login')
# 4. Azure PowerShell
# 5. Interactive browser
#
# For local development, run 'az login' before running the application.
# For production in Azure, use Managed Identity.
