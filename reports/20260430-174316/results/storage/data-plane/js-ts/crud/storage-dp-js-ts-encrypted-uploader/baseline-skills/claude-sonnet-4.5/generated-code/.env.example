# Azure Storage Account URL
# Format: https://<storage-account-name>.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net

# Azure Key Vault URL
# Format: https://<key-vault-name>.vault.azure.net
AZURE_KEY_VAULT_URL=https://your-key-vault.vault.azure.net

# Azure Key Vault Key Name
# The name of the RSA key in your Key Vault to use for wrapping data encryption keys
AZURE_KEY_VAULT_KEY_NAME=your-key-name

# Optional: Azure authentication (if not using managed identity)
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
