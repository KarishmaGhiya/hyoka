# Azure Storage Account Endpoint (required)
# Format: https://<storage-account-name>.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_ENDPOINT=https://mystorageaccount.blob.core.windows.net

# Container name to use for blob operations
AZURE_CONTAINER_NAME=demo-container

# Optional: Retry configuration
AZURE_STORAGE_MAX_RETRIES=3
AZURE_STORAGE_MAX_RETRY_DELAY_MS=60000

# Optional: Log level (verbose | info | warning | error)
AZURE_LOG_LEVEL=info

# Note: This project uses DefaultAzureCredential for authentication.
# No connection strings or account keys are needed.
# 
# DefaultAzureCredential will try these authentication methods in order:
# 1. Environment variables (AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET)
# 2. Managed Identity (when running in Azure)
# 3. Azure CLI (az login)
# 4. Visual Studio Code
# 5. Azure PowerShell
#
# For local development, run: az login
# For Azure deployment, enable Managed Identity on your resource
