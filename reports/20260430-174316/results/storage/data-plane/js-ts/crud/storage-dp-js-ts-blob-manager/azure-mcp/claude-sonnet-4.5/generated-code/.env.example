# Azure Storage Configuration
# Required: Storage account endpoint (uses managed identity for authentication)
AZURE_STORAGE_ENDPOINT=https://yourstorageaccount.blob.core.windows.net

# Optional: Container name (defaults to 'demo-container')
AZURE_STORAGE_CONTAINER=demo-container

# Optional: Retry configuration (defaults shown)
AZURE_STORAGE_MAX_RETRIES=3
AZURE_STORAGE_RETRY_DELAY_MS=1000

# Optional: SDK logging level (verbose, info, warning, error)
AZURE_STORAGE_LOG_LEVEL=info
