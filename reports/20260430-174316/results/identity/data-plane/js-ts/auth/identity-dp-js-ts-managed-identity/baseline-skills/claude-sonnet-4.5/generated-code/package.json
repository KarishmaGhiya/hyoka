{
  "name": "managed-identity-examples",
  "version": "1.0.0",
  "description": "Comprehensive examples for using Azure Managed Identity with Node.js/TypeScript",
  "main": "complete-example.ts",
  "scripts": {
    "start": "ts-node complete-example.ts",
    "validate": "ts-node -e \"import('./common-pitfalls').then(m => m.pitfall6_TestingStrategy())\"",
    "test-auth": "ts-node -e \"import('./local-development-fallback').then(m => m.testAuthentication())\""
  },
  "keywords": [
    "azure",
    "managed-identity",
    "authentication",
    "typescript",
    "azure-sdk"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@azure/identity": "^4.0.0",
    "@azure/storage-blob": "^12.17.0",
    "@azure/storage-queue": "^12.16.0",
    "@azure/keyvault-secrets": "^4.8.0",
    "@azure/cosmos": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0"
  }
}
