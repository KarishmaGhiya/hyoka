# Azure Managed Identity Configuration Examples

# Environment (local, development, staging, production)
ENVIRONMENT=local
NODE_ENV=development

# User-Assigned Managed Identity
AZURE_USER_ASSIGNED_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_USER_ASSIGNED_RESOURCE_ID=/subscriptions/{sub-id}/resourcegroups/{rg}/providers/Microsoft.ManagedIdentity/userAssignedIdentities/{identity-name}
AZURE_USER_ASSIGNED_OBJECT_ID=00000000-0000-0000-0000-000000000000

# Multiple User-Assigned Identities (when resource has multiple)
KEYVAULT_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000001
STORAGE_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000002

# Service Principal (for local development alternative)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret-here

# Azure Resources
KEY_VAULT_URL=https://my-keyvault.vault.azure.net
STORAGE_ACCOUNT_NAME=mystorageaccount
SERVICE_BUS_NAMESPACE=my-servicebus.servicebus.windows.net
SERVICE_BUS_QUEUE_NAME=test-queue
COSMOS_ENDPOINT=https://my-cosmos.documents.azure.com:443/
