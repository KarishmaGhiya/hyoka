{
  "name": "azure-key-vault-config-provider",
  "version": "1.0.0",
  "description": "TypeScript Node.js application configuration provider backed by Azure Key Vault.",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "azure",
    "key-vault",
    "configuration",
    "typescript",
    "nodejs"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@azure/keyvault-secrets": "^4.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
