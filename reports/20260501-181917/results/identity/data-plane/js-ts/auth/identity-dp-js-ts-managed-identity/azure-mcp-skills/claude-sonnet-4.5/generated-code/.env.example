# Optional: User-assigned managed identity client ID
USER_ASSIGNED_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional: Azure Storage account name for testing
STORAGE_ACCOUNT_NAME=mystorageaccount

# Optional: Multiple user-assigned identity client IDs (comma-separated)
ADDITIONAL_CLIENT_IDS=client-id-1,client-id-2,client-id-3
