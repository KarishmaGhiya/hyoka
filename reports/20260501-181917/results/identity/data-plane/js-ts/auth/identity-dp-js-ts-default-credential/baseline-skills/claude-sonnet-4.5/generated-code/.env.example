# Required: Your Key Vault name (without the .vault.azure.net suffix)
AZURE_KEYVAULT_NAME=your-keyvault-name

# Optional: Name of the secret to retrieve (defaults to "MySecret")
SECRET_NAME=MySecret

# Optional: Service Principal credentials (if not using Azure CLI or Managed Identity)
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
