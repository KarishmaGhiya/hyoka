# Required: Your Key Vault name (without .vault.azure.net)
AZURE_KEYVAULT_NAME=my-keyvault

# Optional: Name of the secret to retrieve (defaults to "my-secret")
AZURE_SECRET_NAME=my-secret

# ===== Optional: Service Principal Authentication =====
# If you want to use service principal instead of CLI/managed identity,
# uncomment and set these variables:

# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# ===== Or: Service Principal with Certificate =====
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_CERTIFICATE_PATH=/path/to/cert.pem
# AZURE_CLIENT_CERTIFICATE_PASSWORD=optional-password

# ===== Or: Workload Identity (Kubernetes) =====
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_FEDERATED_TOKEN_FILE=/var/run/secrets/tokens/azure-identity
