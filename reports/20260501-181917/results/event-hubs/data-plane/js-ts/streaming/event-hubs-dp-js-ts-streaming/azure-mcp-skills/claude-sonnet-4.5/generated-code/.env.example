# Azure Event Hubs Configuration
EVENTHUB_CONNECTION_STRING=Endpoint=sb://YOUR-NAMESPACE.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=YOUR-KEY
EVENTHUB_NAME=my-event-hub

# Azure Storage Configuration (for checkpointing)
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR-ACCOUNT;AccountKey=YOUR-KEY;EndpointSuffix=core.windows.net
STORAGE_CONTAINER_NAME=eventhub-checkpoints
