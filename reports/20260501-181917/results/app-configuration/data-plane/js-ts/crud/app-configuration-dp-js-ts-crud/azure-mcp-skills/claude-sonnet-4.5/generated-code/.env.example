# Azure App Configuration Connection String
# Get this from Azure Portal → Your App Configuration → Access keys
AZURE_APPCONFIG_CONNECTION_STRING=Endpoint=https://<your-resource>.azconfig.io;Id=<id>;Secret=<secret>

# Alternative: Use endpoint with DefaultAzureCredential
# AZURE_APPCONFIG_ENDPOINT=https://<your-resource>.azconfig.io
# AZURE_TOKEN_CREDENTIALS=prod
