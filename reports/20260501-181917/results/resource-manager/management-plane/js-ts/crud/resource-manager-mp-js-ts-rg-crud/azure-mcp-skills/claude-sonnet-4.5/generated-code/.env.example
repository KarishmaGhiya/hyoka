# Azure Subscription ID (Required)
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Optional: Service Principal Authentication
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# DefaultAzureCredential will use the following credential chain:
# 1. EnvironmentCredential (environment variables above)
# 2. WorkloadIdentityCredential (Kubernetes)
# 3. ManagedIdentityCredential (Azure VM, App Service, etc.)
# 4. VisualStudioCodeCredential
# 5. AzureCliCredential (az login)
# 6. AzurePowerShellCredential (Connect-AzAccount)
# 7. AzureDeveloperCliCredential (azd auth login)
