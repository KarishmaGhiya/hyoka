# Azure Key Vault Configuration
# Copy this file to .env and fill in your values

# Option 1: Specify vault name (will construct URL automatically)
AZURE_KEYVAULT_NAME=your-keyvault-name

# Option 2: Specify full vault URL (alternative to vault name)
# KEY_VAULT_URL=https://your-keyvault-name.vault.azure.net

# Optional: For production scenarios with specific credential requirements
# AZURE_TOKEN_CREDENTIALS=prod
