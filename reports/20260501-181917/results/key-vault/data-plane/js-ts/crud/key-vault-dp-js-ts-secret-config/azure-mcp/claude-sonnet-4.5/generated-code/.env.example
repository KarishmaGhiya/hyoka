# Azure Key Vault Configuration
AZURE_KEYVAULT_URL=https://your-keyvault-name.vault.azure.net/

# These are automatically used by DefaultAzureCredential in order:
# 1. Environment variables (AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_TENANT_ID)
# 2. Managed Identity (when running in Azure)
# 3. Azure CLI (for local development)
# 4. Other credential sources

# For local development with Azure CLI:
# Run: az login
# Then the app will use your Azure CLI credentials

# For production with Managed Identity:
# No configuration needed - runs automatically in Azure
