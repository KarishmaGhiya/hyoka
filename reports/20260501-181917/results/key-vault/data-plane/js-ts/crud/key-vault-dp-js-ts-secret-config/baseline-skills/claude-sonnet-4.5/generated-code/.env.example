# Azure Key Vault Configuration
KEY_VAULT_URL=https://your-vault-name.vault.azure.net

# Alternative format
# AZURE_KEYVAULT_URL=https://your-vault-name.vault.azure.net

# Note: When running in Azure (App Service, Container Apps, Functions, VMs),
# Managed Identity authentication is automatic - no additional credentials needed.
#
# For local development, use Azure CLI authentication:
# az login
# az account set --subscription <subscription-id>
