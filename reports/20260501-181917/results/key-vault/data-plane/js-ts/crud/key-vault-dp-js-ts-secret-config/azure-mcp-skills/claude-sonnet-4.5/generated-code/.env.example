# Azure Key Vault Configuration
# Copy this file to .env and fill in your values

# Required: Your Azure Key Vault URL
KEY_VAULT_URL=https://your-vault-name.vault.azure.net

# Optional: For local development with DefaultAzureCredential
# Uncomment and fill these if using service principal authentication
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# AZURE_TENANT_ID=your-tenant-id

# Optional: For managed identity (production)
# AZURE_CLIENT_ID=your-managed-identity-client-id
