# Environment Configuration Template
# Copy this file to .env and fill in your values

# Required: Azure Storage Account endpoint
# Format: https://<your-account-name>.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_ENDPOINT=https://youraccount.blob.core.windows.net

# Optional: Container name for demo
AZURE_CONTAINER_NAME=demo-container

# Optional: Azure SDK log level
# Options: verbose | info | warning | error
AZURE_LOG_LEVEL=info

# Note: No connection strings or account keys needed!
# This application uses managed identity (DefaultAzureCredential)
# 
# For local development, ensure you're logged in via Azure CLI:
#   az login
#
# For Azure environments (App Service, Functions, VMs, AKS):
#   Enable system-assigned or user-assigned managed identity
#   Grant "Storage Blob Data Contributor" role to the identity
