# Azure Storage Account Configuration
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_STORAGE_CONTAINER_NAME=demo-container

# Retry Policy Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000
MAX_RETRY_DELAY_MS=30000

# SDK Logging Level (verbose, info, warning, error)
AZURE_LOG_LEVEL=info

# Azure Identity - Required for DefaultAzureCredential in production
# AZURE_TOKEN_CREDENTIALS=prod

# For local development with Azure CLI (run: az login)
# No additional environment variables needed - DefaultAzureCredential will use AzureCliCredential

# For Managed Identity in Azure (App Service, VM, Container Apps, etc.)
# No additional configuration needed - DefaultAzureCredential will automatically detect

# For Service Principal authentication (optional)
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
