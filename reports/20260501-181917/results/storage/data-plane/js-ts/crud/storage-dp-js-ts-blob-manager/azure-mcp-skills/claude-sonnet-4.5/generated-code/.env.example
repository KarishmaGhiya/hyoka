# Azure Storage Account Configuration
# Required: Storage account name (without .blob.core.windows.net)
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name

# Optional: Container name (defaults to 'demo-container')
AZURE_CONTAINER_NAME=demo-container

# Optional: Retry policy configuration
RETRY_MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Optional: Azure SDK logging level
# Options: verbose, info, warning, error
AZURE_LOG_LEVEL=info

# Note: No connection strings or account keys needed!
# The app uses DefaultAzureCredential which supports:
# - Environment variables (AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_TENANT_ID)
# - Managed Identity (when running in Azure)
# - Azure CLI authentication (for local development)
# - Visual Studio Code authentication
# - And more...
