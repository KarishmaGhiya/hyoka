# Azure Key Vault configuration
AZURE_KEYVAULT_URL=https://your-keyvault.vault.azure.net/
AZURE_KEYVAULT_KEY_NAME=encryption-key

# Azure Storage Account configuration
AZURE_STORAGE_ACCOUNT_URL=https://yourstorageaccount.blob.core.windows.net/

# Azure Managed Identity credentials (automatically picked up by DefaultAzureCredential)
# No explicit credentials needed when using Managed Identity
# For local development, you can use Azure CLI authentication: az login
