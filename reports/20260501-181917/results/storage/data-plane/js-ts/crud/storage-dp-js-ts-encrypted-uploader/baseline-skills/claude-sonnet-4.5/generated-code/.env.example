# Azure Key Vault Configuration
KEY_VAULT_URL=https://<your-keyvault-name>.vault.azure.net
KEY_VAULT_KEY_NAME=encryption-key

# Azure Storage Configuration
AZURE_STORAGE_ACCOUNT_NAME=<your-storage-account-name>
CONTAINER_NAME=encrypted-files

# Note: This project uses ManagedIdentityCredential for authentication.
# Ensure your Azure environment (VM, App Service, Container Apps, etc.)
# has a managed identity with the following permissions:
#
# Key Vault Permissions:
#   - Key: Get, Wrap Key, Unwrap Key
#
# Storage Permissions:
#   - Storage Blob Data Contributor (or similar role)
