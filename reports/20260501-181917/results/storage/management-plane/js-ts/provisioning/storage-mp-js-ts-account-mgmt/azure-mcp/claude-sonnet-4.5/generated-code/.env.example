# Azure Subscription Configuration
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Resource Group (must already exist)
RESOURCE_GROUP_NAME=my-resource-group

# Storage Account Name (optional - will generate unique name if not provided)
# Must be 3-24 characters, lowercase letters and numbers only
STORAGE_ACCOUNT_NAME=mystorageaccount123

# Optional: Service Principal Authentication (if not using Azure CLI)
# AZURE_CLIENT_ID=your-client-id
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_SECRET=your-client-secret
