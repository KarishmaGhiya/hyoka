# Azure Subscription Configuration
AZURE_SUBSCRIPTION_ID=your-subscription-id-here
AZURE_RESOURCE_GROUP=rg-storage-demo

# Optional: Custom storage account name (auto-generated if not provided)
# STORAGE_ACCOUNT_NAME=mystorageaccount123

# Optional: Service Principal Authentication (if not using Azure CLI)
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
