# Azure Subscription ID (Required)
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Option 1: Azure CLI (Recommended for local development)
# Run: az login

# Option 2: Service Principal with Client Secret
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# Option 3: Managed Identity (Automatically configured in Azure services)
# No additional configuration needed when running in Azure
