# Azure Service Principal Credentials
# Copy this file to .env and fill in your actual values
# NEVER commit .env to source control!

# Required for Service Principal authentication
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# Optional: For sovereign clouds (e.g., Azure Government, Azure China)
# AZURE_AUTHORITY_HOST=https://login.microsoftonline.us

# Example Azure resources to test against
AZURE_KEYVAULT_URL=https://your-keyvault-name.vault.azure.net
AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
