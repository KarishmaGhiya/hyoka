# Azure Storage Account Configuration
AZURE_STORAGE_ACCOUNT_NAME=mystorageaccount

# Azure Storage Container Name
AZURE_STORAGE_CONTAINER_NAME=encrypted-blobs

# Azure Key Vault Configuration
AZURE_KEY_VAULT_URL=https://myvault.vault.azure.net
AZURE_KEY_VAULT_KEY_NAME=my-encryption-key

# Azure Authentication (optional - defaults to DefaultAzureCredential)
# For local development, use Azure CLI: az login
# For production, use managed identity (no credentials needed)

# Optional: Service Principal authentication
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
