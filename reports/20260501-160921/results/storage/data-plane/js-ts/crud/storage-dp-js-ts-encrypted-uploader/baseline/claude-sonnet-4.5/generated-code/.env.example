# Azure Storage Account Configuration
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name

# Azure Key Vault Configuration
AZURE_KEY_VAULT_URL=https://your-keyvault-name.vault.azure.net/
AZURE_KEY_VAULT_KEY_NAME=encryption-key

# Azure Storage Container (optional, defaults to 'encrypted-files')
AZURE_STORAGE_CONTAINER_NAME=encrypted-files

# Managed Identity Configuration (optional)
# If running locally, use Azure CLI login: az login
# If running in Azure (VM, App Service, etc.), managed identity will be used automatically
