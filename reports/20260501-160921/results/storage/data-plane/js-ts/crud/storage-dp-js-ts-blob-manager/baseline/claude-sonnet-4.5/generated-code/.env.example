# Azure Storage Account Endpoint
# Format: https://<storage-account-name>.blob.core.windows.net
AZURE_STORAGE_ENDPOINT=https://yourstorageaccount.blob.core.windows.net

# Container name for blob operations
CONTAINER_NAME=demo-container

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY_MS=4000

# Logging level: verbose, info, warning, error
LOG_LEVEL=info
