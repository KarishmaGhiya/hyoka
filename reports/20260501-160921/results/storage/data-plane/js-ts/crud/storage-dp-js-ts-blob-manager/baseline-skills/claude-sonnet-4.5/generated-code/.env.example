# Azure Storage Configuration
AZURE_STORAGE_ACCOUNT_ENDPOINT=https://<your-storage-account>.blob.core.windows.net

# Optional: Container name (defaults to 'demo-container')
AZURE_STORAGE_CONTAINER_NAME=demo-container

# Optional: Retry configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Optional: Logging level (verbose, info, warning, error)
LOG_LEVEL=info
