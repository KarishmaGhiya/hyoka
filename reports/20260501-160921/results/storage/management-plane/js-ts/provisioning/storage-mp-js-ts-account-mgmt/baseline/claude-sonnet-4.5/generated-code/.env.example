# Azure Subscription and Resource Configuration
AZURE_SUBSCRIPTION_ID=your-subscription-id-here
AZURE_RESOURCE_GROUP=myResourceGroup
AZURE_STORAGE_ACCOUNT=mystorageaccount

# Optional: Skip deletion step (set to true to keep the storage account)
SKIP_DELETE=false

# Optional: Azure Service Principal Authentication
# (Not required if using Azure CLI authentication)
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
