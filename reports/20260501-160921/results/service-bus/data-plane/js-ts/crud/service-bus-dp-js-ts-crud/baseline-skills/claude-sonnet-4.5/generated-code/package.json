{
  "name": "azure-service-bus-demo",
  "version": "1.0.0",
  "description": "Demonstrates Azure Service Bus messaging patterns in TypeScript",
  "main": "service-bus-demo.ts",
  "scripts": {
    "start": "ts-node service-bus-demo.ts",
    "build": "tsc",
