# Azure Service Bus Connection String
# Get this from Azure Portal or Azure CLI
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<your-key>

# Optional: Override default queue/topic names
# QUEUE_NAME=demo-queue
# TOPIC_NAME=demo-topic
# SUBSCRIPTION_NAME=demo-subscription
